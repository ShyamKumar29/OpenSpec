# The only place a backend URL appears (docs/14-frontend-implementation-plan.md §4.1).
# Defaults to the mock HTTP layer under app/api/mock/v1. Backend integration is a base-URL
# change plus deleting app/api/mock/ (D4) — nothing else should reference a backend host.
NEXT_PUBLIC_API_BASE_URL=/api/mock/v1

# Set to "0" to disable simulated mock latency (used by Playwright/E2E runs).
# See docs/14-frontend-implementation-plan.md §4.3.
NEXT_PUBLIC_MOCK_LATENCY=1
