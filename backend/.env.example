# Copy to .env. `Settings` (src/openspec/config/settings.py) fails fast on a missing
# required value rather than silently defaulting.

# "memory" (default) runs the read-only demo dataset with no external dependencies.
# "postgres" is designed (infrastructure/db/models.py) but not yet wired to a
# repository implementation — selecting it raises at startup. See
# docs/15-backend-implementation-status.md.
OPENSPEC_REPOSITORY_BACKEND=memory

OPENSPEC_DATABASE_URL=postgresql+psycopg://openspec:openspec@localhost:5432/openspec
OPENSPEC_DEFAULT_TENANT_ID=tenant_demo
